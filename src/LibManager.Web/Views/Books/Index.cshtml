@*
    Người thực hiện: Đinh Anh Tuấn – MSSV 2410900083
    Công việc: W3-03 – quản lý đầu sách, thể loại, xóa mềm (tuần 3, nhánh feature/tuan-dau-sach)
    Đề tài DT10 LibManager – Nhóm 07 – K24CNT1
*@
@model PagedList<BookCardVm>
@{ ViewData["Title"] = "Đầu sách"; }
<div class="page-title">
    <div><h1>Đầu sách &amp; bản sao</h1><div class="sub">Quản lý biên mục, bản sao và nhãn mã vạch.</div></div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Import"><i class="bi bi-filetype-csv"></i> Nhập CSV</a>
        <a class="btn btn-outline-secondary" asp-action="Labels"><i class="bi bi-printer"></i> In nhãn mới nhất</a>
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Thêm đầu sách</a>
    </div>
</div>
<form method="get" class="card card-body mb-3">
    <div class="row g-2">
        <div class="col-md-6"><input id="bookSearch" name="q" value="@ViewBag.Q" class="form-control" placeholder="Nhan đề, tác giả, ISBN hoặc quét mã bản sao…" autocomplete="off" /></div>
        <div class="col-md-4"><select name="categoryId" asp-items="(Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.Categories" class="form-select"><option value="">Tất cả thể loại</option></select></div>
        <div class="col-md-2"><button class="btn btn-primary w-100"><i class="bi bi-search"></i> Lọc</button></div>
    </div>
</form>
<div class="card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th></th><th>Nhan đề</th><th>Thể loại</th><th>Năm</th><th class="text-center">Sẵn sàng / Tổng</th><th></th></tr></thead>
            <tbody>
            @foreach (var b in Model.Items)
            {
                <tr>
                    <td style="width:56px">@Ui.Cover(b.Title, b.CoverUrl, "cover-sm")</td>
                    <td><a asp-action="Details" asp-route-id="@b.Id" class="fw-semibold text-decoration-none">@b.Title</a><div class="small text-muted">@b.Authors</div></td>
                    <td>@b.Category</td>
                    <td>@b.PublishYear</td>
                    <td class="text-center"><span class="badge @(b.Available > 0 ? "text-bg-success" : "text-bg-warning")">@b.Available / @b.Total</span>@if (b.IsReferenceOnly) { <span class="badge text-bg-secondary ms-1">Tại chỗ</span> }</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@b.Id" title="Sửa"><i class="bi bi-pencil"></i></a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Labels" asp-route-bookId="@b.Id" title="In nhãn"><i class="bi bi-printer"></i></a>
                    </td>
                </tr>
            }
            @if (!Model.Items.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">Không có đầu sách phù hợp.</td></tr> }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white"><partial name="_Pager" model="(Model.Page, Model.TotalPages, Model.Total)" /></div>
</div>
@section Scripts {
    <script src="~/js/barcode-scanner.js" asp-append-version="true"></script>
    <script>
        // Quét mã bản sao/ISBN ở trang danh sách → tìm ngay
        new BarcodeScanner({ input: '#bookSearch', refocus: false, onScan: (code) => { location.href = '?q=' + encodeURIComponent(code); } }).start();
    </script>
}
